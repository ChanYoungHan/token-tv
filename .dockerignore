!token_tv/assets/*.png
!token_tv/assets/theme-catalog.json
!token_tv/assets/theme-votes.json
!docker/
!docker/entrypoint.sh

# Explicit exclusions also apply inside the allowed source directories.
**/.env*
**/.aws/**
**/.claude/**
**/.codex/**
**/.docker/**
**/auth.json
**/.credentials.json
**/credentials.json
